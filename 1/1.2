import math

def circle_properties(radius):
    area = round(math.pi * radius ** 2, 2)
    circumference = round(2 * math.pi * radius, 2)
    return (area, circumference)
    
print(circle_properties(5))    # (78.54, 31.42)
print(circle_properties(2.5))  # (19.63, 15.71)
print(circle_properties(10))   # (314.16, 62.83)

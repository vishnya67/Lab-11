from datetime import datetime

class Calculator:
    def __init__(self):
        self.history = []

    def _add_record(self, a, b, op, result):
        time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.history.append(f"{time} | {a} {op} {b} = {result}")

    def add(self, a, b):
        result = a + b
        self._add_record(a, b, "+", result)
        return result

    def subtract(self, a, b):
        result = a - b
        self._add_record(a, b, "-", result)
        return result

    def multiply(self, a, b):
        result = a * b
        self._add_record(a, b, "*", result)
        return result

    def divide(self, a, b):
        result = a / b
        self._add_record(a, b, "/", result)
        return result

    def save_history(self, filename="history.txt"):
        with open(filename, "w", encoding="utf-8") as file:
            for record in self.history:
                file.write(record + "\n")

    def load_history(self, filename="history.txt"):
        with open(filename, "r", encoding="utf-8") as file:
            self.history = [line.strip() for line in file]
